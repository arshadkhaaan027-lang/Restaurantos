rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Cafe customer profiles:
    // Customers can read and update only their own profile
    match /cafes/{cafeId}/customers/{customerId} {
      allow get: if isOwner(customerId);
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isOwner(customerId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.cafeId == cafeId;
      allow update: if isOwner(customerId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.cafeId == resource.data.cafeId;
      allow delete: if false;
    }

    // Cafe loyalty memberships:
    // Diners and staff can read and manage cafe loyalty memberships
    match /cafes/{cafeId}/memberships/{customerId} {
      allow read: if true;
      allow create, update: if request.resource.data.cafeId == cafeId;
      allow delete: if false;
    }

    // Orders placed in cafe:
    // Diners at tables and kitchen staff/owner can read, place and manage orders for this cafe
    match /cafes/{cafeId}/orders/{orderId} {
      allow read: if true;
      allow create: if request.resource.data.cafeId == cafeId;
      allow update: if request.resource.data.cafeId == cafeId || request.resource.data.cafeId == resource.data.cafeId;
      allow delete: if false;
    }

    // Auditable stamp transactions:
    match /cafes/{cafeId}/stamp_transactions/{transactionId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    // Notifications:
    match /cafes/{cafeId}/notifications/{notificationId} {
      allow read, write: if true;
    }

    // Menu dishes:
    // Public read for QR diners, cafe staff/owner can modify
    match /cafes/{cafeId}/dishes/{dishId} {
      allow read, write: if true;
    }

    // Inventory items and stock:
    match /cafes/{cafeId}/inventory/{itemId} {
      allow read, write: if isSignedIn();
    }

    // Offers and Promotions:
    // Public read for QR diners, signed-in staff/owner can modify
    match /cafes/{cafeId}/offers/{offerId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Cafe QR Menu Customization & Config:
    match /cafes/{cafeId}/config/{configId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Suppliers & Purchases:
    match /cafes/{cafeId}/suppliers/{supplierId} {
      allow read, write: if isSignedIn();
    }
  }
}
